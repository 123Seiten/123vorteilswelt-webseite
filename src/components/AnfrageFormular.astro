---
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;
const telHref = brand.company.phone.replace(/\s+/g, '');
---
<section class="band band--dark reveal" id="anfrage">
  <div class="wrap">
    <p class="eyebrow on-dark">Einkaufsanalyse</p>
    <h2 class="display">Finden wir heraus, wo Sie zu viel zahlen.</h2>

    <div class="formwrap">
      <ul class="reasons">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Professionelle Analyse</b><p>Einmalig 290 € netto*) – die Umsetzung der Einsparungen ist als Full-Service inklusive. *) Alle Preise netto zzgl. USt.</p></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Antwort innerhalb von 24 Stunden</b><p>Ihr regionaler Ansprechpartner meldet sich persönlich bei Ihnen.</p></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Ergebnis schwarz auf weiß</b><p>Sie bekommen eine nachvollziehbare Aufstellung, keine Verkaufspräsentation.</p></div></li>
      </ul>

      <div class="formcard">
        <!-- Stufe A: Formular -->
        <div id="stageForm">
          <h3 class="display stage-title">Ihre Anfrage</h3>
          <p style="font-size:.9rem;color:var(--grey-500);margin-bottom:20px">Fünf Angaben genügen. Alles Weitere besprechen wir im Gespräch.</p>
          <div class="chips" id="chips"><span class="chip chip--none">Noch keine Bereiche ausgewählt</span></div>
          <div class="fields">
            <div class="f-full"><label for="fFirma">Firma</label><input id="fFirma" type="text" placeholder="Musterbetrieb GmbH"></div>
            <div class="f-full"><label for="fName">Ansprechpartner</label><input id="fName" type="text" placeholder="Vor- und Nachname"></div>
            <div><label for="fPlz">PLZ</label><input id="fPlz" type="text" inputmode="numeric" placeholder="8041"></div>
            <div><label for="fTel">Telefon</label><input id="fTel" type="tel" placeholder="0664 1234567"></div>
            <div class="f-full"><label for="fMail">E-Mail</label><input id="fMail" type="email" placeholder="name@betrieb.at"></div>
          </div>

          <input type="hidden" id="fFormular" value="anfrage">
          <input type="hidden" id="fTs">
          <div class="hp" aria-hidden="true">
            <label for="fGotcha">Bitte leer lassen</label>
            <input type="text" id="fGotcha" autocomplete="off" tabindex="-1">
          </div>

          <p class="consent-check">
            <label>
              <input type="checkbox" id="fDatenschutz" required>
              <span>Ich habe die <a href={`${base}datenschutz`}>Datenschutzerklärung</a> gelesen und bin einverstanden.</span>
            </label>
          </p>

          <button class="btn" id="sendBtn" type="button">Unverbindliche Anfrage senden</button>
          <p class="form-error hidden" id="formError"></p>
          <p class="form-error hidden" id="sendError">
            Konnte gerade nicht übermittelt werden. Bitte in ein paar Minuten erneut versuchen — oder rufen Sie uns an: <a href={`tel:${telHref}`}>{brand.company.phone}</a> · <a href={`mailto:${brand.email}`}>{brand.email}</a>.
          </p>
          <p class="consent"><b>Mit dem Absenden stellen Sie eine unverbindliche Anfrage</b> – Sie kaufen damit nichts und es entstehen keine Kosten. Ob und wann Sie die professionelle Analyse (einmalig 290 € netto*)) beauftragen, entscheiden Sie danach in Ruhe. *) Alle Preise netto zzgl. USt.</p>
        </div>

        <!-- Stufe B: Bestätigung -->
        <div id="stageDone" class="hidden">
          <div class="done">
            <div class="done-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h3 class="display" style="margin-bottom:10px">Anfrage eingegangen</h3>
            <p style="color:var(--grey-700);font-size:.98rem;max-width:44ch;margin:0 auto 18px" id="doneTxt">Vielen Dank! Ihr regionaler Ansprechpartner meldet sich innerhalb von 24 Stunden bei Ihnen.</p>
            <p style="font-size:.84rem;color:var(--grey-500)" id="doneHinweis" class="hidden">Ihre Anfrage wurde übermittelt, eine Bestätigungs-E-Mail konnte nicht versendet werden.</p>
            <button class="btn btn--sm" id="resetBtn" type="button" style="margin-top:20px;width:auto">Ablauf noch einmal durchspielen</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var stageForm = document.getElementById('stageForm')!;
    var stageDone = document.getElementById('stageDone')!;
    var sendBtn = document.getElementById('sendBtn') as HTMLButtonElement;
    var formError = document.getElementById('formError')!;
    var sendError = document.getElementById('sendError')!;
    var doneHinweis = document.getElementById('doneHinweis')!;
    var sendBtnLabel = sendBtn.textContent || 'Unverbindliche Anfrage senden';

    var tsField = document.getElementById('fTs') as HTMLInputElement;
    tsField.value = String(Date.now());

    function feldWert(id: string): string {
      var el = document.getElementById(id) as HTMLInputElement | null;
      return el ? el.value.trim() : '';
    }

    function ausgewaehlteChips(containerId: string): string[] {
      var container = document.getElementById(containerId);
      if (!container) return [];
      return Array.prototype.slice
        .call(container.querySelectorAll('.chip:not(.chip--none)'))
        .map(function (c: Element) { return (c.textContent || '').trim(); });
    }

    function zeigeBestaetigung(hinweisCode: string | null): void {
      stageForm.classList.add('hidden');
      stageDone.classList.remove('hidden');
      doneHinweis.classList.toggle('hidden', !hinweisCode);
      stageDone.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function zeigeSendeFehler(): void {
      sendBtn.disabled = false;
      sendBtn.textContent = sendBtnLabel;
      sendError.classList.remove('hidden');
    }

    sendBtn.addEventListener('click', function () {
      formError.classList.add('hidden');
      sendError.classList.add('hidden');
      var name = feldWert('fName');
      var email = feldWert('fMail');
      var plz = feldWert('fPlz');
      var datenschutz = document.getElementById('fDatenschutz') as HTMLInputElement;
      if (!name || !email || !plz || !datenschutz.checked) {
        formError.textContent = 'Bitte Ansprechpartner, E-Mail und PLZ angeben und der Datenschutzerklärung zustimmen.';
        formError.classList.remove('hidden');
        return;
      }

      sendBtn.disabled = true;
      sendBtn.textContent = 'Wird gesendet…';

      var endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
      if (!endpoint) {
        zeigeBestaetigung(null);
        return;
      }

      var formData = new FormData();
      formData.append('formular', 'anfrage');
      formData.append('name', name);
      formData.append('firma', feldWert('fFirma'));
      formData.append('email', email);
      formData.append('telefon', feldWert('fTel'));
      formData.append('plz', plz);
      formData.append('datenschutz', datenschutz.checked ? '1' : '');
      formData.append('_gotcha', feldWert('fGotcha'));
      formData.append('_ts', tsField.value);
      ausgewaehlteChips('chips').forEach(function (b) { formData.append('bereiche[]', b); });

      fetch(endpoint, { method: 'POST', body: formData })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ok) {
            zeigeBestaetigung(data.hinweis || null);
          } else {
            zeigeSendeFehler();
          }
        })
        .catch(function () {
          zeigeSendeFehler();
        });
    });

    document.getElementById('resetBtn')!.addEventListener('click', function () {
      stageDone.classList.add('hidden');
      stageForm.classList.remove('hidden');
      sendBtn.disabled = false;
      sendBtn.textContent = sendBtnLabel;
      document.getElementById('bereiche')!.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>
