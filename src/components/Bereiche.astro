---
---
<section class="band" id="bereiche">
  <div class="wrap">
    <div class="areas-head">
      <div class="rule"></div>
      <h2 class="display">Wo kaufen Sie ein?</h2>
      <p class="lead">Wählen Sie die Bereiche aus, die wir für Sie prüfen sollen. Wir stellen daraus Ihren Prüfauftrag zusammen.</p>
    </div>

    <div class="tiles" id="tiles">
      <button class="tile" type="button" aria-pressed="false" data-area="Strom &amp; Gas">Strom &amp; Gas<small>Tarife, Netz, Anbieterwechsel</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Versicherungen">Versicherungen<small>Betrieb, Haftpflicht, KFZ</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Fuhrpark &amp; Leasing">Fuhrpark &amp; Leasing<small>Firmenwagen, Nutzfahrzeuge</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Treibstoff">Treibstoff<small>Tankkarten, Flottenrabatte</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Material &amp; Rohstoffe">Material &amp; Rohstoffe<small>Einkaufskonditionen, Staffelpreise</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Maschinen">Maschinen<small>Beschaffung, Wartung, Leasing</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Büroausstattung">Büroausstattung<small>Möbel, IT, Verbrauchsmaterial</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Telekommunikation">Telekommunikation<small>Mobilfunk, Internet, Telefonie</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Werbung &amp; Marketing">Werbung &amp; Marketing<small>Agenturen, Druck, Online</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Steuerberatung">Steuerberatung<small>Honorare, Leistungsumfang</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Bankgebühren">Bankgebühren<small>Konten, Zahlungsverkehr, Terminals</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
      <button class="tile" type="button" aria-pressed="false" data-area="Entsorgung">Entsorgung<small>Abfall, Recycling, Container</small><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M20 6 9 17l-5-5"/></svg></span></button>
    </div>

    <div class="order">
      <div class="order-list">
        <div class="order-head"><strong>Ihr Prüfauftrag</strong><span>Entwurf</span></div>
        <ul id="orderItems"></ul>
        <p class="order-empty" id="orderEmpty">Noch nichts ausgewählt. Tippen Sie oben auf die Bereiche, in denen wir für Sie nachsehen sollen.</p>
      </div>
      <div class="order-act">
        <div class="order-count"><span id="cnt">0</span><small id="cntLabel">Bereiche ausgewählt</small></div>
        <button class="btn" id="orderBtn" type="button" disabled>Bereiche prüfen lassen</button>
        <p class="btn-note" style="margin-top:0">Kostenlos und unverbindlich.</p>
      </div>
    </div>
  </div>
</section>
