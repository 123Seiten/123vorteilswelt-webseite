---
import TileSelect from './TileSelect.astro';

const items = [
  { value: 'Strom & Gas', label: 'Strom & Gas', hint: 'Tarife, Netz, Anbieterwechsel' },
  { value: 'Versicherungen', label: 'Versicherungen', hint: 'Betrieb, Haftpflicht, KFZ' },
  { value: 'Fuhrpark & Leasing', label: 'Fuhrpark & Leasing', hint: 'Fahrzeugflotte, Treibstoffe, Wartung' },
  { value: 'Weiterbildung', label: 'Weiterbildung', hint: 'Schulungen, Fortbildungen, Kurse' },
  { value: 'Material & Rohstoffe', label: 'Material & Rohstoffe', hint: 'Einkaufskonditionen, Staffelpreise' },
  { value: 'Maschinen', label: 'Maschinen', hint: 'Beschaffung, Wartung, Leasing' },
  { value: 'Büroausstattung', label: 'Büroausstattung', hint: 'Möbel, IT, Verbrauchsmaterial' },
  { value: 'Telekommunikation', label: 'Telekommunikation', hint: 'Mobilfunk, Internet, Telefonie' },
  { value: 'Werbung & Marketing', label: 'Werbung & Marketing', hint: 'Agenturen, Druck, Online' },
  { value: 'Steuerberatung', label: 'Steuerberatung', hint: 'Honorare, Leistungsumfang' },
  { value: 'Bankgebühren', label: 'Bankgebühren', hint: 'Konten, Zahlungsverkehr, Terminals' },
  { value: 'Entsorgung', label: 'Entsorgung', hint: 'Abfall, Recycling, Container' },
];
---
<TileSelect
  id="bereiche"
  heading="Wo kaufen Sie ein?"
  lead="Wählen Sie die Bereiche aus, die wir für Sie prüfen sollen. Wir stellen daraus Ihren Prüfauftrag zusammen."
  items={items}
  orderTitle="Ihr Prüfauftrag"
  emptyText="Noch nichts ausgewählt. Tippen Sie oben auf die Bereiche, in denen wir für Sie nachsehen sollen."
  unitSingular="Bereich"
  unitPlural="Bereiche"
  itemStatusText="wird geprüft"
  idleButtonText="Bereiche prüfen lassen"
  activeButtonTemplate="Diese {n} {unit} prüfen lassen"
  helperText="Unverbindlich. Details zu den Analysekosten finden Sie im nächsten Schritt."
  targetSectionId="anfrage"
  targetFocusId="fFirma"
  targetChipsId="chips"
/>
