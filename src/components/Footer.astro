---
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h4>{brand.name}</h4>
        <p style="max-width:34ch">Die Einkaufsabteilung für Klein- und Mittelbetriebe. {brand.tagline} – österreichweit, regional betreut.</p>
        <div class="franchise-link">
          <b>Sie möchten selbst Partner werden?</b><br>
          <a href={`${base}franchise`}>Franchise-Partner werden</a>
        </div>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p>{brand.name} GmbH<br>Ivica Osim Platz 2/5<br>A-8041 Graz</p>
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </div>
      <div>
        <h4>Rechtliches</h4>
        <a href={`${base}impressum`}>Impressum</a>
        <a href="#">Datenschutz</a>
        <a href="#">AGB</a>
      </div>
    </div>
    <div class="fbottom">
      <p>Prototyp zur internen Abstimmung · Stand Juli 2026 · Inhalte, Bilder und Zahlen sind teilweise Platzhalter</p>
      <div class="social">
        <a href="#" class="social-link" aria-label={`${brand.name} auf Instagram`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" class="social-link" aria-label={`${brand.name} auf Facebook`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="social-link" aria-label={`${brand.name} auf YouTube`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.2v5.6l5-2.8z" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
