---
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;
const telHref = brand.company.phone.replace(/\s+/g, '');
---
<section class="band band--dark reveal" id="bewerbung">
  <div class="wrap">
    <p class="eyebrow on-dark">Mach den ersten Schritt</p>
    <h2 class="display">Bewirb dich jetzt als Franchisenehmer</h2>

    <div class="formwrap">
      <ul class="reasons">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Unverbindlich</b><p>Die Bewerbung ist ein erstes Kennenlernen, keine Verpflichtung.</p></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Persönliche Rückmeldung</b><p>Wir melden uns persönlich bei dir.</p></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M20 6 9 17l-5-5"/></svg><div><b>Deine Region im Blick</b><p>Wir klären gleich mit, welches Bundesland für dich noch frei ist.</p></div></li>
      </ul>

      <div class="formcard">
        <!-- Stufe A: Formular -->
        <div id="bfStageForm">
          <h3 class="display stage-title">Deine Bewerbung</h3>
          <p style="font-size:.9rem;color:var(--grey-500);margin-bottom:20px">Ein paar Angaben genügen. Alles Weitere besprechen wir im Gespräch.</p>
          <div class="chips" id="bewerbungChips"><span class="chip chip--none">Noch keine Regionen ausgewählt</span></div>
          <div class="fields">
            <div class="f-full"><label for="bfName">Name</label><input id="bfName" type="text" placeholder="Vor- und Nachname"></div>
            <div><label for="bfMail">E-Mail</label><input id="bfMail" type="email" placeholder="du@beispiel.at"></div>
            <div><label for="bfTel">Telefon</label><input id="bfTel" type="tel" placeholder="0664 1234567"></div>
            <div><label for="bfPlz">PLZ</label><input id="bfPlz" type="text" inputmode="numeric" placeholder="8041"></div>
            <div><label for="bfFirma">Firma <span class="optional-tag">(optional)</span></label><input id="bfFirma" type="text" placeholder="Falls vorhanden"></div>
            <div class="f-full">
              <label>Ich bin:</label>
              <div class="slotgrid" id="bfTypeGroup">
                <button class="slot" type="button" data-value="bestehender Betrieb" aria-pressed="false">Bestehender Betrieb</button>
                <button class="slot" type="button" data-value="Quereinsteiger" aria-pressed="false">Quereinsteiger:in</button>
              </div>
            </div>
          </div>

          <input type="hidden" id="bfFormular" value="franchise">
          <input type="hidden" id="bfTs">
          <div class="hp" aria-hidden="true">
            <label for="bfGotcha">Bitte leer lassen</label>
            <input type="text" id="bfGotcha" autocomplete="off" tabindex="-1">
          </div>

          <p class="consent-check">
            <label>
              <input type="checkbox" id="bfDatenschutz" required>
              <span>Ich habe die <a href={`${base}datenschutz`}>Datenschutzerklärung</a> gelesen und bin einverstanden.</span>
            </label>
          </p>

          <button class="btn" id="bfSendBtn" type="button">Bewerbung senden</button>
          <p class="form-error hidden" id="bfFormError"></p>
          <p class="form-error hidden" id="bfSendError">
            Konnte gerade nicht übermittelt werden. Bitte in ein paar Minuten erneut versuchen — oder rufen Sie uns an: <a href={`tel:${telHref}`}>{brand.company.phone}</a> · <a href={`mailto:${brand.email}`}>{brand.email}</a>.
          </p>
        </div>

        <!-- Stufe B: Bestätigung -->
        <div id="bfStageDone" class="hidden">
          <div class="done">
            <div class="done-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h3 class="display" style="margin-bottom:10px">Bewerbung eingegangen</h3>
            <p style="color:var(--grey-700);font-size:.98rem;max-width:44ch;margin:0 auto 18px" id="bfDoneTxt">Danke für deine Bewerbung, wir melden uns persönlich bei dir.</p>
            <p style="font-size:.84rem;color:var(--grey-500)" id="bfDoneHinweis" class="hidden">Deine Bewerbung wurde übermittelt, eine Bestätigungs-E-Mail konnte nicht versendet werden.</p>
            <button class="btn btn--sm" id="bfResetBtn" type="button" style="margin-top:20px;width:auto">Ablauf noch einmal durchspielen</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var stageForm = document.getElementById('bfStageForm')!;
    var stageDone = document.getElementById('bfStageDone')!;
    var sendBtn = document.getElementById('bfSendBtn') as HTMLButtonElement;
    var resetBtn = document.getElementById('bfResetBtn')!;
    var doneHinweis = document.getElementById('bfDoneHinweis')!;
    var formError = document.getElementById('bfFormError')!;
    var sendError = document.getElementById('bfSendError')!;
    var sendBtnLabel = sendBtn.textContent || 'Bewerbung senden';

    var tsField = document.getElementById('bfTs') as HTMLInputElement;
    tsField.value = String(Date.now());

    function feldWert(id: string): string {
      var el = document.getElementById(id) as HTMLInputElement | null;
      return el ? el.value.trim() : '';
    }

    function ausgewaehlteChips(containerId: string): string[] {
      var container = document.getElementById(containerId);
      if (!container) return [];
      return Array.prototype.slice
        .call(container.querySelectorAll('.chip:not(.chip--none)'))
        .map(function (c: Element) { return (c.textContent || '').trim(); });
    }

    document.querySelectorAll<HTMLButtonElement>('#bfTypeGroup .slot').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('#bfTypeGroup .slot').forEach(function (o) {
          o.setAttribute('aria-pressed', 'false');
        });
        b.setAttribute('aria-pressed', 'true');
      });
    });

    function zeigeBestaetigung(hinweisCode: string | null): void {
      stageForm.classList.add('hidden');
      stageDone.classList.remove('hidden');
      doneHinweis.classList.toggle('hidden', !hinweisCode);
      stageDone.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function zeigeSendeFehler(): void {
      sendBtn.disabled = false;
      sendBtn.textContent = sendBtnLabel;
      sendError.classList.remove('hidden');
    }

    sendBtn.addEventListener('click', function () {
      formError.classList.add('hidden');
      sendError.classList.add('hidden');
      var name = feldWert('bfName');
      var email = feldWert('bfMail');
      var typ = document.querySelector('#bfTypeGroup .slot[aria-pressed="true"]');
      var regionen = ausgewaehlteChips('bewerbungChips');
      var datenschutz = document.getElementById('bfDatenschutz') as HTMLInputElement;
      if (!name || !email || !typ || regionen.length === 0 || !datenschutz.checked) {
        formError.textContent = 'Bitte Name, E-Mail, „Ich bin", mindestens eine Region angeben und der Datenschutzerklärung zustimmen.';
        formError.classList.remove('hidden');
        return;
      }

      sendBtn.disabled = true;
      sendBtn.textContent = 'Wird gesendet…';

      var endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
      var bestehenderBetrieb = typ.getAttribute('data-value') || '';
      if (!endpoint) {
        zeigeBestaetigung(null);
        return;
      }

      var formData = new FormData();
      formData.append('formular', 'franchise');
      formData.append('name', name);
      formData.append('firma', feldWert('bfFirma'));
      formData.append('email', email);
      formData.append('telefon', feldWert('bfTel'));
      formData.append('plz', feldWert('bfPlz'));
      formData.append('bestehender_betrieb', bestehenderBetrieb);
      formData.append('datenschutz', datenschutz.checked ? '1' : '');
      formData.append('_gotcha', feldWert('bfGotcha'));
      formData.append('_ts', tsField.value);
      regionen.forEach(function (r) { formData.append('regionen[]', r); });

      fetch(endpoint, { method: 'POST', body: formData })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ok) {
            zeigeBestaetigung(data.hinweis || null);
          } else {
            zeigeSendeFehler();
          }
        })
        .catch(function () {
          zeigeSendeFehler();
        });
    });

    resetBtn.addEventListener('click', function () {
      stageDone.classList.add('hidden');
      stageForm.classList.remove('hidden');
      sendBtn.disabled = false;
      sendBtn.textContent = sendBtnLabel;
      var regionenSection = document.getElementById('regionen');
      if (regionenSection) regionenSection.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>
