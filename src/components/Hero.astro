---
import HintergrundBild from './HintergrundBild.astro';
---
<section class="hero" id="top">
  <HintergrundBild eintrag="hero-bg" class="hero-bg-layer" loading="eager" />
  <div class="hero-bg-overlay" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Einkaufsvorteile für Klein- und Mittelbetriebe</p>
      <h1 class="display">Wir sind Ihre neue <em>Einkaufs&shy;abteilung</em></h1>
      <p class="hero-sub">Umsatz muss man sich hart erarbeiten. Ersparnisse sind sofortige Gewinne. Wir verhandeln Ihren betrieblichen Einkauf für Sie neu, auf Erfolgsbasis, mit der Marktmacht eines Großkunden.</p>
      <div class="hero-cta">
        <a class="btn" href="#bereiche">Professionelle Analyse anfordern</a>
      </div>
      <p class="btn-note">Professionelle Einkaufsanalyse · Umsetzung und Begleitung inklusive</p>
      <div class="hero-facts">
        <span class="fact"><b>10–15 %</b>&nbsp;durchschnittliche Ersparnis</span>
        <span class="fact"><b>Jährlich</b>&nbsp;neu verhandelt</span>
        <span class="fact"><b>Österreichweit</b>&nbsp;regional betreut</span>
      </div>
    </div>

    <div class="sheet" aria-label="Beispielhafte Kostenaufstellung">
      <div class="sheet-head">
        <strong>Kostenblatt</strong>
        <span>Beispiel</span>
      </div>
      <div class="row"><span class="k">Strom &amp; Gas</span><span class="dots"></span><span class="v num">8.400 €</span><span class="v2 num">6.700 €</span></div>
      <div class="row"><span class="k">Versicherungen</span><span class="dots"></span><span class="v num">6.200 €</span><span class="v2 num">5.100 €</span></div>
      <div class="row"><span class="k">Fuhrpark</span><span class="dots"></span><span class="v num">14.900 €</span><span class="v2 num">13.200 €</span></div>
      <div class="row"><span class="k">Telekommunikation</span><span class="dots"></span><span class="v num">2.100 €</span><span class="v2 num">1.450 €</span></div>
      <div class="row"><span class="k">Material</span><span class="dots"></span><span class="v num">31.000 €</span><span class="v2 num">27.800 €</span></div>
      <div class="sheet-total">
        <span>Ersparnis pro Jahr</span>
        <strong class="num">9.350 €</strong>
      </div>
      <p class="sheet-foot">Beispielhafte Darstellung – Ihre tatsächlichen Zahlen ermitteln wir im Rahmen der Analyse.</p>
    </div>
  </div>
</section>
