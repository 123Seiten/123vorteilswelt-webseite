---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
import '../styles/global.css';
import '../styles/fonts.css';

interface Props {
  title?: string;
  hideCta?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  stickyCtaLabel?: string;
  stickyCtaHref?: string;
  showPartnerLink?: boolean;
}

const base = import.meta.env.BASE_URL;
const {
  title = `${brand.name} – Ihre neue Einkaufsabteilung`,
  hideCta = false,
  ctaLabel = 'Analyse anfordern',
  ctaHref = `${base}#bereiche`,
  stickyCtaLabel = 'Einkaufsanalyse anfordern',
  stickyCtaHref = `${base}#bereiche`,
  showPartnerLink = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{title}</title>
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>

<Header hideCta={hideCta} ctaLabel={ctaLabel} ctaHref={ctaHref} showPartnerLink={showPartnerLink} />

<slot />

<Footer />

{!hideCta && <div class="sticky"><a class="btn" href={stickyCtaHref}>{stickyCtaLabel}</a></div>}

<script>
  (function () {
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;

    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced || !('IntersectionObserver' in window)) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
    );

    els.forEach(function (el) {
      observer.observe(el);
    });
  })();
</script>

</body>
</html>
