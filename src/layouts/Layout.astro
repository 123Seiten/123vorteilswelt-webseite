---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = '123Vorteilswelt – Prototyp Kundenwebseite' } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="proto"><b>Prototyp</b> · Entwurf zur Abstimmung · Bilder, Logo und Fallbeispiele sind Platzhalter · Es werden keine Daten übertragen</div>

<Header />

<slot />

<Footer />

<div class="sticky"><a class="btn" href="#bereiche">Kostenlose Analyse anfordern</a></div>

</body>
</html>
