---
import Layout from '../layouts/Layout.astro';
import TileSelect from '../components/TileSelect.astro';
import FranchiseBewerbung from '../components/FranchiseBewerbung.astro';
import HintergrundBild from '../components/HintergrundBild.astro';
import { brand } from '../config/brand';

const base = import.meta.env.BASE_URL;

const regionen = [
  'Burgenland',
  'Kärnten',
  'Niederösterreich',
  'Oberösterreich',
  'Salzburg',
  'Steiermark',
  'Tirol',
  'Vorarlberg',
  'Wien',
].map((name) => ({ value: name, label: name }));
---

<Layout
  title={`Franchise-Partner werden – ${brand.name}`}
  ctaLabel="Bewerbung starten"
  ctaHref="#regionen"
  stickyCtaLabel="Bewerbung starten"
  stickyCtaHref="#regionen"
>

  <!-- HERO — Die Idee -->
  <section class="hero">
    <HintergrundBild eintrag="franchise-hero-bg" class="hero-bg-layer" loading="eager" />
    <div class="hero-bg-overlay" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Deine Chance</p>
        <h1 class="display">Sei die <em>Einkaufsabteilung</em> für Kleinbetriebe.</h1>
        <p class="hero-sub">
          Du hast ein Gespür für Zahlen, Verhandlung und den Aufbau von Kundenbeziehungen? Als Franchise-Partner oder -partnerin von 123Vorteilswelt verhilfst du kleinen und mittelständischen Betrieben zu den Top-Einkaufskonditionen bei Strom, Versicherungen, Fuhrpark, Treibstoff, Material, Maschinen, Büroausstattung, Werbung und Steuerberatung.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#regionen">Franchise-Partner werden</a>
        </div>
        <p class="btn-note">Unverbindlich · Eigene Region · Ohne Vorabinvestition in Ware</p>
        <div class="hero-facts">
          <span class="fact"><b>738.000</b>&nbsp;Unternehmen in Österreich</span>
          <span class="fact"><b>99,7&nbsp;%</b>&nbsp;davon Klein- und Mittelbetriebe</span>
          <span class="fact"><b>10–15&nbsp;%</b>&nbsp;Ersparnis pro Kunde</span>
        </div>
      </div>

      <div class="hero-video">
        <video id="franchiseVid" class="hero-video-el" playsinline autoplay muted loop preload="metadata"
               poster={`${base}video/franchise-partner-poster.jpg`}>
          <source src={`${base}video/franchise-partner.mp4`} type="video/mp4" />
        </video>
        <div class="hero-video-ctrls">
          <button type="button" class="vbtn" id="vSound" aria-pressed="false" aria-label="Ton einschalten"><span class="vlabel">Ton an</span></button>
          <button type="button" class="vbtn" id="vRestart" aria-label="Video neu starten"><span class="vlabel">Neu starten</span></button>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKTPOTENZIAL -->
  <section class="band band--grey reveal">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Marktpotenzial</p>
      <h2 class="display">Ein Markt, der noch niemandem gehört.</h2>
      <p class="lead">
        Österreichs Wirtschaft besteht fast vollständig aus kleinen und mittleren Unternehmen. Sie stehen für
        56&nbsp;% der Bruttowertschöpfung der marktorientierten Wirtschaft – haben aber selten die Zeit, das
        Personal oder die Marktmacht, ihre Einkaufskosten systematisch zu optimieren. Genau hier entsteht ein
        enormer, bislang kaum organisierter Markt für professionelles Einkaufsmanagement.
      </p>

      <ul class="mkt-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
          <p><b>Rund 738.000 Unternehmen</b> in Österreich – praktisch alle ohne eigene Einkaufsabteilung.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
          <p>Steigende <b>Energie- und Arbeitskosten</b> setzen KMU-Margen unter Dauerdruck.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
          <p><b>10–15&nbsp;% Ersparnis</b> pro Kunde – ein sofort spürbarer, schwarz-auf-weiß belegbarer Mehrwert.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
          <p><b>Jährliche Neuverhandlung</b> bedeutet wiederkehrende Betreuung statt Einmalgeschäft.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 5l7 7-7 7"/></svg>
          <p><b>Kein Risiko für den Kunden</b> durch reine Erfolgsvergütung – der leichteste Einstieg überhaupt.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WER ZU UNS PASST -->
  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Wer zu uns passt</h2>

      <div class="fit-grid">
        <p class="lead" style="max-width:none">
          123Vorteilswelt richtet sich an Menschen mit Verhandlungsgeschick und unternehmerischem Denken: an
          bestehende Berater:innen und Vertriebsprofis genauso wie an motivierte Quereinsteiger:innen, die ein
          eigenes, sinnstiftendes Business aufbauen wollen. Du brauchst kein Lager, keine Maschinen, keine
          Vorabinvestition in Ware. Was du mitbringst: Freude am Kontakt mit Unternehmer:innen und den Willen,
          deinen Kund:innen echtes Geld zu sparen. Den Rest – Analyseprozess, Lieferantennetzwerk, gebündelte
          Marktmacht und Marke – bringt 123Vorteilswelt mit.
        </p>
        <div class="photo">
          <HintergrundBild eintrag="wer-zu-uns-passt" />
        </div>
      </div>
    </div>
  </section>

  <!-- EIN FRANCHISESYSTEM MIT ZUKUNFT -->
  <section class="band band--dark reveal">
    <div class="wrap">
      <p class="eyebrow on-dark">Ein Franchisesystem mit Zukunft</p>
      <h2 class="display">Sechs Gründe, die für sich sprechen.</h2>

      <div class="pillars">
        <div class="pillar">
          <span class="pillar-n">1</span>
          <h3 class="display">Erfolgsbasiertes Modell</h3>
          <p>Der Kunde zahlt nur, wenn er wirklich spart. Kaum ein Einwand, kaum ein Risiko.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">2</span>
          <h3 class="display">Sofort spürbarer Mehrwert</h3>
          <p>10–15&nbsp;% Ersparnis, für den Kunden schwarz auf weiß belegt.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">3</span>
          <h3 class="display">Wiederkehrende Erträge</h3>
          <p>Jährliche Neuverhandlung bedeutet laufende Provision statt Einmalgeschäft.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">4</span>
          <h3 class="display">Bundesweite Marktmacht</h3>
          <p>Gebündelte Nachfrage verschafft deinen Kunden Konditionen wie einem Großkonzern.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">5</span>
          <h3 class="display">Gebietsschutz &amp; starke Marke</h3>
          <p>Deine Region gehört dir, im Rücken eine österreichweite Marke.</p>
        </div>
        <div class="pillar">
          <span class="pillar-n">6</span>
          <h3 class="display">Schlanker Start</h3>
          <p>Kein Lager, keine Maschinen, kein Fuhrpark – du startest ohne Warenrisiko.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DER UNTERSCHIED, DER ZÄHLT -->
  <section class="band reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Der Unterschied, der zählt</h2>

      <div class="compare">
        <div class="compare-card">
          <p class="compare-label">Traditionell</p>
          <p>
            Kostenoptimierung heißt bisher: einen Berater engagieren, der ein Honorar kostet – unabhängig
            davon, ob am Ende wirklich etwas eingespart wird. Aufwändig, teuer, mit ungewissem Ergebnis. Für
            viele KMU deshalb schlicht keine Option.
          </p>
        </div>
        <div class="compare-card is-featured">
          <p class="compare-label">Mit 123Vorteilswelt</p>
          <p>
            Du analysierst die Einkaufsstruktur kostenfrei, verhandelst die besten Konditionen und wirst
            ausschließlich am Erfolg vergütet – <b>30&nbsp;% der jährlichen Ersparnis</b>. Keine Ersparnis,
            keine Kosten. Für den Kunden ein Angebot, das man kaum ablehnen kann.
          </p>
        </div>
      </div>

      <p class="compare-note">
        <b>Das bedeutet für dich als Franchise-Partner:</b> ein Verkaufsargument, das sich fast von selbst
        verkauft, kurze Entscheidungswege beim Kunden und wiederkehrende Erträge durch die jährliche
        Neuverhandlung – mehr Zeit für das, was du am besten kannst: Kunden gewinnen und betreuen.
      </p>
    </div>
  </section>

  <!-- FRANCHISEKONDITIONEN & KOSTEN -->
  <section class="band band--grey reveal">
    <div class="wrap">
      <div class="rule"></div>
      <h2 class="display">Franchisekonditionen &amp; Kosten</h2>
      <p class="lead">Die Lizenzkosten im Überblick – final abgestimmt werden sie im persönlichen Gespräch.</p>

      <div class="terms">
        <div>
          <p class="lbl">Einstiegsgebühr</p>
          <p class="val">40.000 €</p>
        </div>
        <div>
          <p class="lbl">Laufende Franchisegebühr (vom Nettoumsatz)</p>
          <p class="val">6 %</p>
        </div>
        <div>
          <p class="lbl">Marketingbeitrag (vom Nettoumsatz)</p>
          <p class="val">3 %</p>
        </div>
      </div>

      <p class="terms-note">
        <b>Weitere Investitionen:</b> überschaubar – z.&nbsp;B. Software-/Systemzugang, Büro- oder Homeoffice-Ausstattung und ggf. ein Fahrzeug.
      </p>
    </div>
  </section>

  <!-- VERDIENSTMÖGLICHKEITEN -->
  <section class="band reveal" id="verdienst">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Als Franchise-Partner</p>
      <h2 class="display">Verdienstmöglichkeiten</h2>
      <p class="lead">Ein Rechenbeispiel für ein eingeschwungenes Jahr – konservativ gerechnet, auf Basis von rund 4 betreuten Kunden und 10 Analysen pro Monat.</p>
      <div class="verdienst">
        <p class="v-group">Umsatz</p>
        <div class="v-row"><span>Provisionsumsatz (48 Kunden × 10.335 €)</span><span class="num">496.080 €</span></div>
        <div class="v-row"><span>Analysegebühren (120 × 290 €)</span><span class="num">34.800 €</span></div>
        <div class="v-row v-sum"><span>Nettojahresumsatz</span><span class="num">530.880 €</span></div>
        <p class="v-group">Kosten</p>
        <div class="v-row"><span>Betriebsbedarf (Büro, Telekommunikation, IT)</span><span class="num">24.000 €</span></div>
        <div class="v-row"><span>Leasing (Fahrzeug)</span><span class="num">15.000 €</span></div>
        <div class="v-row"><span>Franchisegebühr (6 %)</span><span class="num">31.853 €</span></div>
        <div class="v-row"><span>Marketingbeitrag (3 %)</span><span class="num">15.926 €</span></div>
        <div class="v-row v-sum"><span>Gesamtkosten</span><span class="num">86.779 €</span></div>
        <div class="v-row v-result"><span>Betriebsergebnis vor Steuer</span><span class="num">444.101 €</span></div>
      </div>
      <p class="v-note">Konservativ gerechnet: alle Kunden mit der Erstjahres-Provision (30 %). Ab dem zweiten Jahr kommen die wiederkehrenden 10 % aus den Kunden der Vorjahre hinzu. Beispielrechnung mit ungefähren Werten – Details im Businessplan, keine Ertragsgarantie.</p>
    </div>
  </section>

  <!-- REGION-AUSWAHL -->
  <TileSelect
    id="regionen"
    heading="In welcher Region möchtest du dich bewerben?"
    lead="Wähle ein oder mehrere Bundesländer aus – wir sagen dir, welche Region noch frei ist."
    note="Diese Anfrage ist noch nicht verbindlich."
    items={regionen}
    tilesModifier="tiles--3col"
    orderTitle="Deine Regionen"
    emptyText="Noch keine Region ausgewählt. Tippe oben auf die Bundesländer, in denen du dich bewerben möchtest."
    unitSingular="Region"
    unitPlural="Regionen"
    itemStatusText="ausgewählt"
    idleButtonText="Region auswählen"
    activeButtonTemplate="Diese {n} {unit} übernehmen"
    helperText="Unverbindlich – der nächste Schritt ist das Bewerbungsformular."
    targetSectionId="bewerbung"
    targetFocusId="bfName"
    targetChipsId="bewerbungChips"
  />

  <!-- BEWERBUNGSFORMULAR -->
  <FranchiseBewerbung />

</Layout>

<script>
  const v = document.getElementById('franchiseVid');
  const s = document.getElementById('vSound');
  const r = document.getElementById('vRestart');
  if (v && s) s.addEventListener('click', () => {
    v.muted = !v.muted;
    s.setAttribute('aria-pressed', String(!v.muted));
    s.querySelector('.vlabel').textContent = v.muted ? 'Ton an' : 'Ton aus';
    s.setAttribute('aria-label', v.muted ? 'Ton einschalten' : 'Ton ausschalten');
    if (!v.muted) v.play?.();
  });
  if (v && r) r.addEventListener('click', () => { v.currentTime = 0; v.play?.(); });
</script>
