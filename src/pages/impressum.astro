---
import Layout from '../layouts/Layout.astro';
import { brand } from '../config/brand';
import { BILDER, BILDQUELLEN_LIZENZ } from '../config/bilder';

const bildEintraege = Object.values(BILDER);
const quellen = [...new Set(bildEintraege.map((b) => b.quelle))];

/** Baut "Label: Wert"-Zeilen und lässt Paare mit leerem Wert automatisch weg. */
function zeilenBlock(paare: Array<[string, string]>): string[] {
  return paare
    .filter(([, wert]) => wert !== '')
    .map(([label, wert]) => `${label}: ${wert}`);
}

const firmenbuchZeilen = zeilenBlock([
  ['Firmenbuchnummer', brand.company.firmenbuchnummer],
  ['Firmenbuchgericht', brand.company.firmenbuchgericht],
  ['UID-Nummer', brand.company.uid],
]);
---

<Layout title={`Impressum – ${brand.name}`}>
  <section class="band">
    <div class="wrap">
      <div class="rule"></div>
      <h1 class="display">Impressum</h1>
      <p class="lead">Angaben gemäß § 5 ECG, § 14 UGB, § 63 GewO und § 25 MedienG.</p>

      <div class="legal">
        <div class="legal-section">
          <h3 class="display">Diensteanbieter</h3>
          <p>
            {brand.company.legalName} i. G.<br>
            {brand.company.street}<br>
            {brand.company.postalCode} {brand.company.city}<br>
            {brand.company.country}
          </p>
          <p>23.09.2026: Die {brand.company.legalName} befindet sich zum heutigen Zeitpunkt in der Gründungsphase. Fehlende Angaben, wie Firmenbuchnummer, Steuernummer, werden nachgereicht, sobald diese vorliegen.</p>
          {firmenbuchZeilen.length > 0 && (
            <p>
              {firmenbuchZeilen.map((zeile, i) => (
                <>{zeile}{i < firmenbuchZeilen.length - 1 && <br />}</>
              ))}
            </p>
          )}
        </div>

        <div class="legal-section">
          <h3 class="display">Vertretungsberechtigte Geschäftsführung</h3>
          <p>{brand.company.managingDirector}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">Kontakt</h3>
          <p>
            Telefon: {brand.company.phone}<br>
            E-Mail: <a href={`mailto:${brand.email}`}>{brand.email}</a>
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Unternehmensgegenstand</h3>
          <p>{brand.company.businessPurpose}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">Berufsbezeichnung/Gewerbe</h3>
          <p>{brand.company.profession} (verliehen in {brand.company.professionCountry})</p>
        </div>

        <div class="legal-section">
          <h3 class="display">Mitgliedschaften</h3>
          <p>
            Mitglied der {brand.company.chamber}<br>
            Anwendbare Rechtsvorschriften: Gewerbeordnung (<a href="https://www.ris.bka.gv.at" target="_blank" rel="noopener">www.ris.bka.gv.at</a>)
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Aufsichtsbehörde</h3>
          <p>{brand.company.authority}</p>
        </div>

        <div class="legal-section">
          <h3 class="display">EU-Streitschlichtung</h3>
          <p>
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit, abrufbar unter
            <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">ec.europa.eu/consumers/odr</a>.
            Wir sind weder bereit noch verpflichtet, an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </div>

        <div class="legal-section">
          <h3 class="display">Bildquellen</h3>
          {quellen.map((quelle) => {
            const lizenz = BILDQUELLEN_LIZENZ[quelle];
            return <p>Bildmaterial: {quelle}{lizenz && ` (${lizenz})`}.</p>;
          })}
          <p>
            {bildEintraege.map((bild, i) => (
              <>
                {bild.beschreibung} ({bild.quelle}{bild.kiGeneriert && ', mit KI erstellt'})
                {i < bildEintraege.length - 1 && <br />}
              </>
            ))}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
