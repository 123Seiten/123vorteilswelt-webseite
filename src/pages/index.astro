---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Problem from '../components/Problem.astro';
import Ablauf from '../components/Ablauf.astro';
import Bereiche from '../components/Bereiche.astro';
import Kosten from '../components/Kosten.astro';
import Ansprechpartner from '../components/Ansprechpartner.astro';
import Fallbeispiele from '../components/Fallbeispiele.astro';
import FAQ from '../components/FAQ.astro';
import AnfrageFormular from '../components/AnfrageFormular.astro';
---

<Layout title="123Vorteilswelt – Prototyp Kundenwebseite">
  <Hero />
  <TrustBar />
  <Problem />
  <Ablauf />
  <Bereiche />
  <Kosten />
  <Ansprechpartner />
  <Fallbeispiele />
  <FAQ />
  <AnfrageFormular />

  <script>
    (function () {
      var selected: string[] = [];
      var tiles = document.querySelectorAll<HTMLButtonElement>('.tile');
      var items = document.getElementById('orderItems')!;
      var empty = document.getElementById('orderEmpty')!;
      var cnt = document.getElementById('cnt')!;
      var cntLabel = document.getElementById('cntLabel')!;
      var orderBtn = document.getElementById('orderBtn') as HTMLButtonElement;
      var chips = document.getElementById('chips')!;

      function decode(s: string) {
        var t = document.createElement('textarea');
        t.innerHTML = s;
        return t.value;
      }

      function render() {
        items.innerHTML = '';
        selected.forEach(function (a) {
          var li = document.createElement('li');
          var k = document.createElement('span');
          k.textContent = a;
          var d = document.createElement('span');
          d.className = 'dots';
          var s = document.createElement('span');
          s.className = 'st';
          s.textContent = 'wird geprüft';
          li.appendChild(k);
          li.appendChild(d);
          li.appendChild(s);
          items.appendChild(li);
        });
        empty.style.display = selected.length ? 'none' : 'block';
        cnt.textContent = String(selected.length);
        cntLabel.textContent = selected.length === 1 ? 'Bereich ausgewählt' : 'Bereiche ausgewählt';
        orderBtn.disabled = selected.length === 0;
        orderBtn.textContent = selected.length
          ? 'Diese ' + selected.length + (selected.length === 1 ? ' Bereich' : ' Bereiche') + ' prüfen lassen'
          : 'Bereiche prüfen lassen';

        chips.innerHTML = '';
        if (!selected.length) {
          var c = document.createElement('span');
          c.className = 'chip chip--none';
          c.textContent = 'Noch keine Bereiche ausgewählt';
          chips.appendChild(c);
        } else {
          selected.forEach(function (a) {
            var c = document.createElement('span');
            c.className = 'chip';
            c.textContent = a;
            chips.appendChild(c);
          });
        }
      }

      tiles.forEach(function (t) {
        t.addEventListener('click', function () {
          var area = decode(t.getAttribute('data-area')!);
          var on = t.getAttribute('aria-pressed') === 'true';
          t.setAttribute('aria-pressed', on ? 'false' : 'true');
          if (on) {
            selected = selected.filter(function (x) {
              return x !== area;
            });
          } else {
            selected.push(area);
          }
          render();
        });
      });

      orderBtn.addEventListener('click', function () {
        document.getElementById('anfrage')!.scrollIntoView({ behavior: 'smooth' });
        setTimeout(function () {
          document.getElementById('fFirma')!.focus({ preventScroll: true });
        }, 700);
      });

      // Formular → Termin → Bestätigung
      var stageForm = document.getElementById('stageForm')!;
      var stageSlot = document.getElementById('stageSlot')!;
      var stageDone = document.getElementById('stageDone')!;
      var slotBtn = document.getElementById('slotBtn') as HTMLButtonElement;
      var chosenSlot: string | null = null;

      document.getElementById('sendBtn')!.addEventListener('click', function () {
        stageForm.classList.add('hidden');
        stageSlot.classList.remove('hidden');
        stageSlot.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      document.querySelectorAll<HTMLButtonElement>('#slots .slot').forEach(function (s) {
        s.addEventListener('click', function () {
          document.querySelectorAll('#slots .slot').forEach(function (o) {
            o.setAttribute('aria-pressed', 'false');
          });
          s.setAttribute('aria-pressed', 'true');
          chosenSlot = s.firstChild!.textContent!.trim();
          slotBtn.disabled = false;
        });
      });

      slotBtn.addEventListener('click', function () {
        stageSlot.classList.add('hidden');
        stageDone.classList.remove('hidden');
        document.getElementById('doneTxt')!.textContent =
          'Ihr Termin am ' + chosenSlot + ' ist vorgemerkt. Ihr Ansprechpartner meldet sich vorher noch einmal kurz bei Ihnen.';
        stageDone.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      document.getElementById('resetBtn')!.addEventListener('click', function () {
        stageDone.classList.add('hidden');
        stageForm.classList.remove('hidden');
        slotBtn.disabled = true;
        chosenSlot = null;
        document.querySelectorAll('#slots .slot').forEach(function (o) {
          o.setAttribute('aria-pressed', 'false');
        });
        document.getElementById('bereiche')!.scrollIntoView({ behavior: 'smooth' });
      });

      render();
    })();
  </script>
</Layout>
